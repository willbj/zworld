{
  "name": "novels",
  "version": "0.1.0",
  "language": "zh",
  "llm": {
    "provider": "openai",
    "service": "deepseek",
    "configSource": "studio",
    "baseUrl": "https://api.deepseek.com",
    "model": "deepseek-v4-flash",
    "apiFormat": "chat",
    "stream": true,
    "services": [
      {
        "service": "deepseek"
      }
    ],
    "defaultModel": "deepseek-v4-flash"
  },
  "notify": [],
  "inputGovernanceMode": "v2",
  "daemon": {
    "schedule": {
      "radarCron": "0 */6 * * *",
      "writeCron": "*/15 * * * *"
    },
    "maxConcurrentBooks": 3
  }
}