# ZWorld Environment Configuration
# Copy to .env and fill in your values

# LLM Provider (openai, anthropic, custom)
ZWORLD_LLM_PROVIDER=openai

# API Base URL (OpenAI-compatible endpoint)
ZWORLD_LLM_BASE_URL=https://api.openai.com/v1

# API Key
ZWORLD_LLM_API_KEY=sk-your-key-here

# Model name
ZWORLD_LLM_MODEL=gpt-4o

# Notifications (optional)
ZWORLD_TELEGRAM_BOT_TOKEN=
ZWORLD_TELEGRAM_CHAT_ID=
ZWORLD_FEISHU_WEBHOOK_URL=
ZWORLD_WECOM_WEBHOOK_URL=
